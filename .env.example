APP_NAME=UltrAI
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=2209
DB_DATABASE=ultrai_db
DB_USERNAME=ultrai_local
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost

MEDIA_TOOLS_ENABLED=true
MEDIA_PYTHON_PATH=
MEDIA_FFMPEG_PATH=
MEDIA_FFPROBE_PATH=
MEDIA_NODE_PATH=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AI_PROXY_URL=
AI_PROXY_KEY=
VITE_APP_NAME="${APP_NAME}"MEDIA_REMBG_MODEL_DIR=
