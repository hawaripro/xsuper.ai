                          "required": [
                            "quad"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "settings": {
                    "properties": {
                      "pbr": {
                        "const": true
                      }
                    },
                    "required": [
                      "pbr"
                    ]
                  }
                },
                "required": [
                  "settings"
                ]
              },
              "then": {
                "properties": {
                  "settings": {
                    "properties": {
                      "texture": {
